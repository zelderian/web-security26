### LAB 3.

### 1. GET all items
GET http://localhost:8080/api/v1/items
Authorization: Basic admin admin
Accept: application/json

> {% client.test("1. GET all", () => client.assert(response.status === 200)); %}

### 2. POST create item
POST http://localhost:8080/api/v1/items
Authorization: Basic admin admin
Content-Type: application/json

{ "name": "Phone", "description": "First" }

> {%
  client.global.set("id", response.body.id);
  client.test("2. POST create", () => client.assert(response.status === 201));
%}


### 3. GET one item
GET http://localhost:8080/api/v1/items/{{id}}
Authorization: Basic admin admin

> {% client.test("3. GET one", () => client.assert(response.status === 200)); %}

###

### 4. PUT update item
PUT http://localhost:8080/api/v1/items/{{id}}
Authorization: Basic admin admin
Content-Type: application/json

{ "name": "Phone v2", "description": "Updated" }

> {% client.test("4. PUT update", () => client.assert(response.status === 200)); %}

###

### 5. GET all items after update
GET http://localhost:8080/api/v1/items
Authorization: Basic admin admin

> {% client.test("5. GET all after update", () => client.assert(response.status === 200)); %}

###

### 6. GET without auth (expect 401)
GET http://localhost:8080/api/v1/items

> {% client.test("6. No auth -> 401", () => client.assert(response.status === 401)); %}

###

### 7. GET with wrong password (expect 401)
GET http://localhost:8080/api/v1/items
Authorization: Basic admin wrong

> {% client.test("7. Wrong password -> 401", () => client.assert(response.status === 401)); %}

###

### 8. GET non-existing item (expect 404)
GET http://localhost:8080/api/v1/items/000000000000000000000000
Authorization: Basic admin admin

> {% client.test("8. Not found -> 404", () => client.assert(response.status === 404)); %}

###

### 9. DELETE item
DELETE http://localhost:8080/api/v1/items/{{id}}
Authorization: Basic admin admin

> {% client.test("9. DELETE", () => client.assert(response.status === 204)); %}

###

### 10. GET deleted item (expect 404)
GET http://localhost:8080/api/v1/items/{{id}}
Authorization: Basic admin admin

> {% client.test("10. Deleted -> 404", () => client.assert(response.status === 404)); %}

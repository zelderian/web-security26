### 1. ADMIN: GET all (200) + get CSRF token
GET http://localhost:8080/api/v1/items
Authorization: Basic admin admin
Accept: application/json

> {%
  client.global.set("xsrf", response.headers.valueOf("X-XSRF-TOKEN"));
  client.test("1. ADMIN GET all -> 200", () => client.assert(response.status === 200));
%}

###

### 2. ADMIN: POST create (201)
POST http://localhost:8080/api/v1/items
Authorization: Basic admin admin
X-XSRF-TOKEN: {{xsrf}}
Content-Type: application/json

{ "name": "Admin item", "description": "created by admin" }

> {%
  client.global.set("id", response.body.id);
  client.test("2. ADMIN POST -> 201", () => client.assert(response.status === 201));
%}

###

### 3. MANAGER: POST create (201)
POST http://localhost:8080/api/v1/items
Authorization: Basic manager manager
X-XSRF-TOKEN: {{xsrf}}
Content-Type: application/json

{ "name": "Manager item", "description": "created by manager" }

> {% client.test("3. MANAGER POST -> 201", () => client.assert(response.status === 201)); %}

###

### 4. USER: POST create (403 forbidden)
POST http://localhost:8080/api/v1/items
Authorization: Basic user user
X-XSRF-TOKEN: {{xsrf}}
Content-Type: application/json

{ "name": "User item", "description": "must be denied" }

> {% client.test("4. USER POST -> 403", () => client.assert(response.status === 403)); %}

###

### 5. USER: GET all (200)
GET http://localhost:8080/api/v1/items
Authorization: Basic user user
Accept: application/json

> {% client.test("5. USER GET all -> 200", () => client.assert(response.status === 200)); %}

###

### 6. USER: GET one (200)
GET http://localhost:8080/api/v1/items/{{id}}
Authorization: Basic user user
Accept: application/json

> {% client.test("6. USER GET one -> 200", () => client.assert(response.status === 200)); %}

###

### 7. MANAGER: PUT update (200)
PUT http://localhost:8080/api/v1/items/{{id}}
Authorization: Basic manager manager
X-XSRF-TOKEN: {{xsrf}}
Content-Type: application/json

{ "name": "Updated by manager", "description": "updated" }

> {% client.test("7. MANAGER PUT -> 200", () => client.assert(response.status === 200)); %}

###

### 8. USER: PUT update (403 forbidden)
PUT http://localhost:8080/api/v1/items/{{id}}
Authorization: Basic user user
X-XSRF-TOKEN: {{xsrf}}
Content-Type: application/json

{ "name": "Hacked", "description": "must be denied" }

> {% client.test("8. USER PUT -> 403", () => client.assert(response.status === 403)); %}

###

### 9. MANAGER: DELETE (403 forbidden)
DELETE http://localhost:8080/api/v1/items/{{id}}
Authorization: Basic manager manager
X-XSRF-TOKEN: {{xsrf}}

> {% client.test("9. MANAGER DELETE -> 403", () => client.assert(response.status === 403)); %}

